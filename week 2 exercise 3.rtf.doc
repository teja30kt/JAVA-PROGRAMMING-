\pard\tx720\cf1\f0\fs38 import java.util.Scanner;\par
\par
public class\f1  Main\f0\{\par
    public static void main(String[] args) \{\par
\par
        Scanner sc = new Scanner(System.in);\par
\par
        String feedback = sc.nextLine();\par
\par
        if (feedback.equals("\\"\\"") || feedback.trim().isEmpty()) \{\par
            System.out.println("Invalid Feedback Message");\par
        \} else \{\par
            String[] words = feedback.trim().split("\\\\s+");\par
            System.out.println("Words = " + words.length);\par
        \}\par
\par
        sc.close();\par
    \}\par
\}\par
}
